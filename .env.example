# ==============================================================================
# DAYFLOW HRMS - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env in your respective frontend and backend folders or root.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Base URL of the backend REST API
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Project Credentials (Public / Anon)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Node.js / Express)
# ------------------------------------------------------------------------------
# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Supabase Project Credentials (Service Role Key for Backend Auth Verification & Admin actions)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Supabase JWT Secret (if performing local JWT verification via jsonwebtoken package)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
